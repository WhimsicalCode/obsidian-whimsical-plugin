{
  "name": "obsidian-whimsical-plugin",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "check": "npm run lint && npm test && npm run build",
    "audit": "npm audit --omit=dev && npm audit --audit-level=high"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "obsidian": "1.8.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
